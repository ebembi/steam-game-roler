# Discord Bot Configuration
# Get your Discord bot token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Steam API Configuration
# Get your Steam API key from: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Server Configuration
# Enable Developer Mode in Discord, then right-click your server → Copy Server ID
GUILD_ID=your_guild_id_here

# Optional: Admin channel for notifications (set to 0 to disable)
ADMIN_CHANNEL_ID=0

# Optional: Timezone for scheduled scans (default: Europe/London)
# See: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=Europe/London

# Game Filtering Configuration
# Minimum playtime in minutes required for a game to get a role (default: 60)
PLAYTIME_MINUTES=60

# Minimum number of server members who must own a game for it to get a role (default: 2)
MIN_PLAYERS=2

# Bot Command Configuration
# Command prefix for bot commands (default: !)
COMMAND_PREFIX=!

# Optional: Admin role ID for command restrictions (set to 0 to allow all users)
ADMIN_ROLE_ID=0
